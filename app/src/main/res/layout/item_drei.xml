<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:orientation="vertical"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/twm_s1_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_weight="1"
            android:gravity="center|clip_horizontal"
            android:text="@string/a2_Title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/twm_s2_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_weight="1"
            android:gravity="center|clip_horizontal"
            android:text="@string/a2_Title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/twm_s3_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_weight="1"
            android:gravity="center|clip_horizontal"
            android:text="@string/a2_Title"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/twm_s1_p"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:gravity="center|clip_horizontal"
            android:maxLines="1"
            android:text="@string/a2_Judul" />

        <TextView
            android:id="@+id/twm_s2_p"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:gravity="center|clip_horizontal"
            android:maxLines="1"
            android:text="@string/a2_Judul" />

        <TextView
            android:id="@+id/twm_s3_p"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:gravity="center|clip_horizontal"
            android:maxLines="1"
            android:text="@string/a2_Judul" />
    </LinearLayout>
</LinearLayout>